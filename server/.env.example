# Railway injects DATABASE_URL automatically once you attach a Postgres
# plugin to this service — you normally don't set it by hand there.
# For local development, point it at any Postgres you have running:
DATABASE_URL=postgres://user:password@localhost:5432/aquaconnect

# Any long random string — used to sign login JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Optional — falls back to a shared demo key baked into src/lib/nifs.js
# (same default D:\202609\index.mjs used) if unset.
NIFS_API_KEY=

# Password seeded for the demo login (leedonggil@haegang.kr) by `npm run seed`.
SEED_DEMO_PASSWORD=demo1234

PORT=8080

# AI 리포트. 어느 AI 를 쓸지는 앱의 lib/main.dart 에서 고릅니다(주석 한 줄 바꾸기).
# 키는 서버 환경변수(Railway Variables)에만 둡니다 — 앱·저장소에 넣지 마세요.
# 고른 AI 의 키가 비어 있으면 AI 리포트는 '미연결'로 표시되고 만들 수 없습니다.
# 모델은 자동 선택: 좋은 모델부터 쓰고, 한도 소진(429)·과부하면 다음(낮은) 모델로 넘어갑니다.

# Gemini (MODEL_API_KEY 는 예전 이름 — 둘 중 하나만 있으면 됩니다)
GEMINI_API_KEY=
MODEL_API_KEY=
# Claude(Anthropic) — console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=

# 모델 순서를 바꾸고 싶을 때만(좋은 것부터, 쉼표로). 비우면 코드의 기본 목록
# 예: GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash,gemini-3.5-flash-lite
GEMINI_MODELS=
# 예: CLAUDE_MODELS=claude-sonnet-5-5,claude-haiku-5-5
CLAUDE_MODELS=
# 모델별 하루 요청 한도(앱의 '남은 횟수' 계산 + 자동 선택 순서). Gemini 결제 연결 후 늘리거나,
# Claude 비용을 묶고 싶을 때. 예: {"gemini-3.8-flash":10000,"claude-opus-5-5":30}
MODEL_DAILY_LIMITS=
# 비우면 Gemini 기본값(https://generativelanguage.googleapis.com/v1beta/openai)
MODEL_BASE_URL=
# 추론 토큰이 출력 한도를 함께 쓰는 Gemini 용. 비우면 low
MODEL_REASONING_EFFORT=
# 응답 대기(ms). 비우면 Gemini 180000, Claude 300000
MODEL_TIMEOUT_MS=

# 관측소 수온 이력: 서버가 1시간마다(매시 20분) 전국 NIFS 관측소 수온을 받아 저장하고,
# 2개월이 지난 자료는 자동으로 지웁니다. off 로 두면 수집하지 않습니다(로컬 시험용).
OCEAN_TEMP_COLLECT=
# AI 리포트의 고수온·저수온 일수 기준(일 평균 수온, ℃). 비우면 25 / 10
HIGH_TEMP_C=
LOW_TEMP_C=
